{
  "name": "naijapulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":         "next dev",
    "build":       "next build",
    "start":       "next start",
    "lint":        "next lint",
    "test":        "vitest run",
    "test:watch":  "vitest",
    "test:ui":     "vitest --ui",
    "test:e2e":    "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all":    "pnpm test && pnpm test:e2e",
    "ingest":      "curl -s -X POST http://localhost:3000/api/ingest -H 'Content-Type: application/json' -d '{}' | jq",
    "enrich":      "curl -s -X POST http://localhost:3000/api/enrich -H 'Content-Type: application/json' -d '{\"limit\":20}' | jq",
    "cluster":     "curl -s -X POST http://localhost:3000/api/cluster | jq"
  },
  "dependencies": {
    "@radix-ui/react-dialog":   "^1.0.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-slider":   "^1.1.2",
    "@radix-ui/react-tabs":     "^1.0.4",
    "@radix-ui/react-tooltip":  "^1.0.7",
    "@supabase/ssr":            "^0.3.0",
    "@supabase/supabase-js":    "^2.39.0",
    "clsx":                     "^2.1.0",
    "date-fns":                 "^3.3.1",
    "framer-motion":            "^11.0.5",
    "lucide-react":             "^0.321.0",
    "next":                     "14.1.0",
    "node-cron":                "^3.0.3",
    "react":                    "^18",
    "react-dom":                "^18",
    "rss-parser":               "^3.13.0",
    "sharp":                    "^0.33.2",
    "tailwind-merge":           "^2.2.1",
    "zod":                      "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test":          "^1.42.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react":    "^15.0.0",
    "@types/node":               "^20",
    "@types/react":              "^18",
    "@types/react-dom":          "^18",
    "@types/rss-parser":         "^3.13.6",
    "@vitejs/plugin-react":      "^4.2.1",
    "@vitest/ui":                "^1.3.1",
    "autoprefixer":              "^10.0.1",
    "eslint":                    "^8",
    "eslint-config-next":        "14.1.0",
    "jsdom":                     "^24.0.0",
    "postcss":                   "^8",
    "tailwindcss":               "^3.3.0",
    "tsx":                       "^4.7.0",
    "typescript":                "^5",
    "vitest":                    "^1.3.1"
  }
}
